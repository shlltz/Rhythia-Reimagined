# Public settings for a relay. Nothing here is secret: the relay has no API keys or passwords.
# Copy to .env and edit. Every RR_ value is optional (defaults shown).

# the domain players type into the game (Caddy gets its HTTPS certificate)
RELAY_DOMAIN=relay.example.org
# shown in invite pages (https://<domain>/j/CODE)
RR_RELAY_PUBLIC_URL=https://relay.example.org

# capacity and abuse limits
RR_MAX_ROOMS=200
RR_MAX_ROOMS_PER_IP=3
RR_MAX_GUESTS=15
RR_MAX_CONNS=2000
RR_MAX_CONNS_PER_IP=24
RR_JOIN_RATE=12
RR_CREATE_RATE=10
RR_BAD_CODES=20
RR_STREAM_RATE=65536
RR_HOST_RATE=1048576
RR_MAX_FRAME=65536
RR_MAX_PENDING=1048576

# timing
RR_HOST_GRACE=25
RR_IDLE_TIMEOUT=40
RR_ROOM_MAX_AGE=43200

# info | debug
RR_LOG=info
